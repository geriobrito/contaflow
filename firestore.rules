rules_version = '2';

// ContaFlow — isolamento de dados por escritório (orgId).
//
// Modelo:
//   users/{uid}            → { uid, orgId, email?, createdAt }  (vínculo usuário → escritório)
//   clients, chart_of_accounts, classification_rules, transactions, import_batches
//                          → todo documento carrega `orgId`.
//
// Garantias:
//   1. Só usuários autenticados com perfil acessam dados, e apenas do próprio escritório.
//   2. Consultas precisam filtrar por orgId (regras de leitura valem para cada resultado).
//   3. `orgId` é imutável: nenhuma escrita move um documento para outro escritório.
//   4. Documentos vinculados a um cliente (clientId) só podem apontar para clientes do
//      mesmo escritório (ou para o plano 'global' do próprio escritório).
//   5. O usuário cria o próprio perfil apenas como dono de um escritório novo
//      (orgId == uid). Entrar em um escritório existente exige alteração administrativa
//      (console / Admin SDK), nunca pelo próprio cliente.
//   6. Trilha de auditoria (audit_log) é somente-inclusão: ninguém edita nem apaga, e o
//      registro precisa ser do próprio usuário autenticado (actorUid == auth.uid), com a
//      data do servidor (`at == request.time`) e uma ação da lista de AuditAction.
//   7. Competência fechada (period_locks/{clientId}_{YYYY-MM}) congela os lançamentos
//      daquele mês: nenhuma alteração nem exclusão até a reabertura (também auditada).
//   8. Pendências com o cliente (client_requests/{token}): o token aleatório de 128 bits
//      é a credencial do link. Sem login, quem tem o link lê aquele documento e grava
//      apenas as respostas (campo `answers`, texto de até 2000 caracteres cada; o link tem
//      de 1 a 24 perguntas, que não mudam), enquanto o link estiver
//      aberto e dentro da validade; ninguém lista a coleção. O cliente não
//      envia arquivos: client_request_files é legado e não aceita novos documentos.
//   9. Lançamento novo nunca entra conciliado: importar em competência fechada não altera
//      o resultado dela.
//  10. Lançamentos manuais (journal_entries) respeitam as partidas dobradas (débitos =
//      créditos) e recebem um número sequencial por cliente (journal_counters), imutável.
//  11. Fechar ou reabrir competência só é aceito junto do registro em audit_log, gravado
//      na mesma operação — e o inverso: registros de fechar/reabrir competência ou
//      exercício só nascem junto da operação. A data do fechamento é a do servidor.
//  12. Papéis: users/{uid}.role == 'operator' (definido só pelo console / Admin SDK) não
//      reabre competência nem exclui empresa, extrato, lançamento, conta do plano, conta
//      bancária ou saldos de abertura; em regras de classificação, só exclui as que ele
//      mesmo criou (`createdByUid == auth.uid`). Sem o campo, é administrador.
//  13. period_snapshots guarda saldos consolidados de competências fechadas: é um cache
//      que o app confere antes de usar, isolado por escritório como os demais dados.
//  14. Encerramento do exercício: todos os lançamentos dele (yearClosing, em 31/12) entram
//      juntos, com dezembro fechado, numa gravação com um único registro em audit_log, e só
//      saem juntos pela reabertura (administrador), também auditada. Nenhum lançamento manual
//      antes da data de implantação.
//  15. explanatory_notes guarda o texto das notas explicativas por cliente e exercício.
//  16. lock_state/{clientId} resume os fechamentos da empresa (`count` competências fechadas
//      agora e `seq` monotônico a cada fechamento de competência ou encerramento do exercício).
//      Nasce junto com a empresa (`count = 0, seq = 0`) ou via Admin SDK (backfill).
//  17. Cadastros que alteram saldos retroativos (`opening_balances`, campos contábeis de
//      `bank_accounts` e estrutura de `chart_of_accounts`) carimbam `lockSeq = seq` e só
//      podem mudar seus campos protegidos quando `count == 0` ou `lockSeq == seq`. Contas
//      compartilhadas legadas (`clientId == 'global'`) têm estrutura fixa.
//
// Limite: cada lote pode consultar até 20 documentos distintos nas regras (perfil,
// cliente e um fechamento por competência). O app agrupa os lotes por competência.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function profilePath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function hasProfile() {
      return signedIn() && exists(profilePath());
    }

    function myOrg() {
      return get(profilePath()).data.orgId;
    }

    function isMine(data) {
      return hasProfile() && data.orgId == myOrg();
    }

    // Administrador do escritório: todo usuário com perfil, exceto quem foi marcado como
    // operador (campo `role`, que o próprio usuário não consegue alterar).
    function isAdmin() {
      return hasProfile() && get(profilePath()).data.get('role', 'admin') != 'operator';
    }

    // clientId deve ser um cliente do mesmo escritório (ou o plano 'global').
    function clientInMyOrg(data) {
      return data.clientId == 'global'
        || (exists(/databases/$(database)/documents/clients/$(data.clientId))
            && get(/databases/$(database)/documents/clients/$(data.clientId)).data.orgId == myOrg());
    }

    function unchanged(field) {
      return request.resource.data[field] == resource.data[field];
    }

    // Competência (YYYY-MM) do lançamento está aberta?
    function monthOpen(tx) {
      return !exists(/databases/$(database)/documents/period_locks/$(tx.clientId + '_' + tx.date[0:7]));
    }

    function lockStatePath(clientId) {
      return /databases/$(database)/documents/lock_state/$(clientId);
    }

    // Nenhuma competência fechada agora (count == 0). Sem lock_state (antes do backfill), falha fechado.
    function hasNoLocks(clientId) {
      let ls = lockStatePath(clientId);
      return exists(ls) && get(ls).data.count == 0;
    }

    // Campo protegido só muda quando nada está fechado (count == 0) ou quando nenhum fechamento
    // ocorreu desde a última gravação protegida deste documento (lockSeq == seq).
    function canEditProtected(clientId, current) {
      let ls = lockStatePath(clientId);
      return exists(ls)
        && (get(ls).data.count == 0
            || (current.get('lockSeq', -1) is int
                && current.get('lockSeq', -1) == get(ls).data.seq));
    }

    function stampsCurrentSeq(clientId, next) {
      let ls = lockStatePath(clientId);
      return exists(ls)
        && next.get('lockSeq', -1) is int
        && next.get('lockSeq', -1) == get(ls).data.seq;
    }

    function touchesFields(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    // ── Perfil do usuário ────────────────────────────────────────────────
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.orgId == uid;
      // Troca de escritório/edição de perfil: somente via Admin SDK.
      allow update, delete: if false;
    }

    // ── Empresas ─────────────────────────────────────────────────────────
    // Termos do Livro Diário no cadastro (ClientDaybookInfo): só três textos de até 120 caracteres.
    function shortText(m, key) {
      return m.get(key, '') is string && m.get(key, '').size() <= 120;
    }
    function validDaybook(data) {
      return !('daybook' in data)
        || (data.daybook is map
            && data.daybook.keys().hasOnly(['number', 'city', 'registry'])
            && shortText(data.daybook, 'number')
            && shortText(data.daybook, 'city')
            && shortText(data.daybook, 'registry'));
    }

    match /clients/{clientId} {
      // Ler id ainda inexistente permite ao saveClient saber se está criando (com lock_state) ou atualizando.
      allow get: if (resource == null && hasProfile()) || isMine(resource.data);
      allow list: if isMine(resource.data);
      allow delete: if isMine(resource.data) && isAdmin();
      allow create: if isMine(request.resource.data)
        && existsAfter(lockStatePath(clientId))
        && validDaybook(request.resource.data);
      allow update: if isMine(resource.data) && unchanged('orgId')
        && validDaybook(request.resource.data);
    }

    // ── Dados vinculados a uma empresa ───────────────────────────────────
    match /chart_of_accounts/{docId} {
      allow get: if (resource == null && hasProfile()) || isMine(resource.data);
      allow list: if isMine(resource.data);
      allow delete: if isMine(resource.data) && isAdmin();
      allow create: if isMine(request.resource.data)
        && clientInMyOrg(request.resource.data)
        && (request.resource.data.clientId == 'global'
            ? !('lockSeq' in request.resource.data)
            : stampsCurrentSeq(request.resource.data.clientId, request.resource.data));
      allow update: if isMine(resource.data)
        && unchanged('orgId') && unchanged('clientId')
        && (!touchesFields(['code', 'type', 'nature', 'parentId', 'level', 'dreGroup', 'isContra', 'lockSeq'])
            || (resource.data.clientId != 'global'
                && canEditProtected(resource.data.clientId, resource.data)
                && stampsCurrentSeq(resource.data.clientId, request.resource.data)));
    }

    match /classification_rules/{docId} {
      allow read: if isMine(resource.data);
      allow delete: if isMine(resource.data)
        && (isAdmin() || resource.data.get('createdByUid', '') == request.auth.uid);
      allow create: if isMine(request.resource.data)
        && clientInMyOrg(request.resource.data)
        && (!('createdByUid' in request.resource.data)
            || request.resource.data.createdByUid == request.auth.uid);
      allow update: if isMine(resource.data)
        && unchanged('orgId') && unchanged('clientId')
        && request.resource.data.get('createdByUid', '') == resource.data.get('createdByUid', '');
    }

    match /transactions/{docId} {
      allow read: if isMine(resource.data);
      // Excluir (ex.: extrato importado por engano) só em competência aberta, e só administrador.
      allow delete: if isMine(resource.data) && isAdmin() && monthOpen(resource.data);
      // Importar em mês fechado é permitido, mas todo lançamento novo entra como pendente/auto
      // (não altera a DRE): só a conciliação — um update, barrado em competência fechada —
      // faz o lançamento contar no resultado.
      allow create: if isMine(request.resource.data)
        && clientInMyOrg(request.resource.data)
        && request.resource.data.status in ['PENDING', 'AUTO_CLASSIFIED'];
      // Nenhuma alteração em competência fechada; data e valor são imutáveis.
      allow update: if isMine(resource.data)
        && unchanged('orgId') && unchanged('clientId') && unchanged('date') && unchanged('amount')
        && monthOpen(resource.data);
    }

    match /import_batches/{docId} {
      allow read: if isMine(resource.data);
      allow delete: if isMine(resource.data) && isAdmin();
      allow create: if isMine(request.resource.data) && clientInMyOrg(request.resource.data);
      allow update: if isMine(resource.data) && unchanged('orgId') && unchanged('clientId');
    }

    // ── Lançamentos contábeis manuais (Diário de Fechamento / Ajustes Avulsos) ─
    // Valor com sinal de uma partida: débito +, crédito − (a mesma leitura do razão em
    // src/lib/ledger.ts). Valor que não é número gera erro de avaliação, e a regra nega.
    // Fica só o essencial de propósito: cada avaliação tem um teto de 1000 expressões, e
    // checar conta e valor positivo por partida o estoura com poucas partidas — isso é
    // validado pelo app (journalEntryProblem em src/lib/journal.ts) antes de gravar.
    function lineValue(l) {
      return l.type == 'DEBIT' ? l.amount : -l.amount;
    }

    // Débitos − créditos. As regras não têm laços: as partidas são somadas uma a uma, até 20
    // (MAX_JOURNAL_LINES em src/lib/journal.ts).
    function linesNet(lines) {
      let n = lines.size();
      return (n > 0 ? lineValue(lines[0]) : 0) + (n > 1 ? lineValue(lines[1]) : 0)
        + (n > 2 ? lineValue(lines[2]) : 0) + (n > 3 ? lineValue(lines[3]) : 0)
        + (n > 4 ? lineValue(lines[4]) : 0) + (n > 5 ? lineValue(lines[5]) : 0)
        + (n > 6 ? lineValue(lines[6]) : 0) + (n > 7 ? lineValue(lines[7]) : 0)
        + (n > 8 ? lineValue(lines[8]) : 0) + (n > 9 ? lineValue(lines[9]) : 0)
        + (n > 10 ? lineValue(lines[10]) : 0) + (n > 11 ? lineValue(lines[11]) : 0)
        + (n > 12 ? lineValue(lines[12]) : 0) + (n > 13 ? lineValue(lines[13]) : 0)
        + (n > 14 ? lineValue(lines[14]) : 0) + (n > 15 ? lineValue(lines[15]) : 0)
        + (n > 16 ? lineValue(lines[16]) : 0) + (n > 17 ? lineValue(lines[17]) : 0)
        + (n > 18 ? lineValue(lines[18]) : 0) + (n > 19 ? lineValue(lines[19]) : 0);
    }

    // Partidas dobradas: de 2 a 20 partidas com débitos = créditos (tolerância de meio
    // centavo para o ponto flutuante), e data YYYY-MM-DD (define a competência).
    function validJournal(entry) {
      return entry.date is string && entry.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && entry.lines is list && entry.lines.size() >= 2 && entry.lines.size() <= 20
        && math.abs(linesNet(entry.lines)) < 0.005;
    }

    function journalCounter(clientId) {
      return /databases/$(database)/documents/journal_counters/$(clientId);
    }

    // O número do lançamento novo é o do contador do cliente, avançado nesta mesma gravação
    // (transação): nunca se repete, nem com dois usuários lançando ao mesmo tempo.
    function takesNextNumber(entry) {
      return entry.entryNumber == getAfter(journalCounter(entry.clientId)).data.last
        && (!exists(journalCounter(entry.clientId))
            || get(journalCounter(entry.clientId)).data.last < entry.entryNumber);
    }

    // Antes da data de implantação (opening_balances.date, posição no início do dia) o movimento
    // já está nos saldos de abertura: nenhum lançamento manual antes dela; no próprio dia, sim.
    function afterImplantation(entry) {
      let opening = /databases/$(database)/documents/opening_balances/$(entry.clientId);
      return !exists(opening) || entry.date >= get(opening).data.date;
    }

    // Encerramento do exercício (src/lib/year-closing.ts): todos os lançamentos dele (marcados
    // com o ano, em 31/12) e um único registro de auditoria nascem numa mesma gravação; cada
    // lançamento aponta o registro em `closingAuditId`. A reabertura apaga todos juntos com o
    // registro `${closingAuditId}_reopen`. É a única exceção à competência fechada: o exercício
    // só se encerra com dezembro fechado.
    function auditDoc(id) {
      return /databases/$(database)/documents/audit_log/$(id);
    }
    function auditedNowAs(id, clientId, action) {
      return !exists(auditDoc(id))
        && existsAfter(auditDoc(id))
        && getAfter(auditDoc(id)).data.action == action
        && getAfter(auditDoc(id)).data.clientId == clientId;
    }
    function isYearClosing(entry) {
      return entry.category == 'CLOSING'
        && entry.get('yearClosing', '') == entry.date[0:4]
        && entry.date[4:10] == '-12-31'
        && entry.get('closingAuditId', '') is string
        && entry.get('closingAuditId', '').size() > 0;
    }
    // Número dentro do bloco reservado no contador por este encerramento.
    function takesClosingNumber(entry) {
      return entry.entryNumber <= getAfter(journalCounter(entry.clientId)).data.last
        && getAfter(journalCounter(entry.clientId)).data.get('closingAudit', '') == entry.closingAuditId
        && (!exists(journalCounter(entry.clientId))
            || get(journalCounter(entry.clientId)).data.last < entry.entryNumber);
    }
    function advancesLockStateOnYearClose(clientId, closingAuditId) {
      let ls = lockStatePath(clientId);
      let after = getAfter(ls).data;
      return exists(ls)
        && after.count == get(ls).data.count
        && after.seq == get(ls).data.seq + 1
        && after.get('lastEvent', {}).get('kind', '') == 'year'
        && after.get('lastEvent', {}).get('lockId', '') == closingAuditId;
    }

    match /journal_entries/{entryId} {
      allow read: if isMine(resource.data);
      // Reabrir o exercício (apagar o encerramento em dezembro fechado): só administrador, auditado.
      allow delete: if isMine(resource.data)
        && (monthOpen(resource.data)
            || (isAdmin() && isYearClosing(resource.data)
                && auditedNowAs(resource.data.closingAuditId + '_reopen', resource.data.clientId, 'YEAR_REOPEN')));
      allow create: if isMine(request.resource.data)
        && clientInMyOrg(request.resource.data)
        && afterImplantation(request.resource.data)
        && validJournal(request.resource.data)
        // O encerramento vem primeiro: assim os lançamentos dele não consultam o fechamento de
        // dezembro (que nem é exigido aberto), e a transação do encerramento lê um documento a
        // menos — ela fica perto do limite de leituras das regras.
        && ((isYearClosing(request.resource.data)
                && auditedNowAs(request.resource.data.closingAuditId, request.resource.data.clientId, 'YEAR_CLOSE')
                && takesClosingNumber(request.resource.data)
                && advancesLockStateOnYearClose(request.resource.data.clientId, request.resource.data.closingAuditId))
            || (monthOpen(request.resource.data) && takesNextNumber(request.resource.data)));
      allow update: if isMine(resource.data)
        && unchanged('orgId') && unchanged('clientId') && unchanged('entryNumber')
        && monthOpen(resource.data) && monthOpen(request.resource.data)
        && afterImplantation(request.resource.data)
        && validJournal(request.resource.data);
    }

    // ── Sequência dos lançamentos manuais (um documento por cliente, id = clientId) ─
    match /journal_counters/{docId} {
      // Ler o contador de um cliente que ainda não tem um (documento inexistente) é permitido ao próprio escritório.
      allow read: if hasProfile() && (resource == null ? clientInMyOrg({'clientId': docId}) : isMine(resource.data));
      allow create: if isMine(request.resource.data)
        && clientInMyOrg(request.resource.data)
        && docId == request.resource.data.clientId
        && request.resource.data.last is int
        && request.resource.data.last >= 1;
      // Só avança: de um em um, ou um bloco (até 100) reservado pelo encerramento do exercício,
      // com o registro YEAR_CLOSE nascendo na mesma gravação.
      allow update: if isMine(resource.data)
        && unchanged('orgId') && unchanged('clientId')
        && (request.resource.data.last == resource.data.last + 1
            || (request.resource.data.last > resource.data.last
                && request.resource.data.last - resource.data.last <= 100
                && request.resource.data.get('closingAudit', '') is string
                && request.resource.data.get('closingAudit', '').size() > 0
                && auditedNowAs(request.resource.data.closingAudit, resource.data.clientId, 'YEAR_CLOSE')));
      // Só some junto com a empresa (enquanto ela existe, a sequência nunca volta atrás).
      allow delete: if isMine(resource.data) && isAdmin()
        && !exists(/databases/$(database)/documents/clients/$(docId));
    }

    // ── Contas bancárias do cliente ──────────────────────────────────────
    match /bank_accounts/{docId} {
      allow get: if (resource == null && hasProfile()) || isMine(resource.data);
      allow list: if isMine(resource.data);
      allow delete: if isMine(resource.data) && isAdmin();
      allow create: if isMine(request.resource.data)
        && clientInMyOrg(request.resource.data)
        && stampsCurrentSeq(request.resource.data.clientId, request.resource.data);
      allow update: if isMine(resource.data)
        && unchanged('orgId') && unchanged('clientId') && unchanged('accountKey')
        && (!touchesFields(['openingBalance', 'openingDate', 'ledgerAccountId', 'ledgerAccountCode', 'ledgerAccountName', 'kind', 'lockSeq'])
            || (canEditProtected(resource.data.clientId, resource.data)
                && stampsCurrentSeq(resource.data.clientId, request.resource.data)));
    }

    // ── Saldos de abertura (um documento por cliente, id = clientId) ─────
    match /opening_balances/{docId} {
      // Ler um cliente que ainda não tem saldos (documento inexistente) é permitido ao próprio escritório.
      allow read: if hasProfile() && (resource == null ? clientInMyOrg({'clientId': docId}) : isMine(resource.data));
      allow delete: if isMine(resource.data) && isAdmin();
      allow create: if isMine(request.resource.data)
        && clientInMyOrg(request.resource.data)
        && docId == request.resource.data.clientId
        && hasNoLocks(request.resource.data.clientId)
        && stampsCurrentSeq(request.resource.data.clientId, request.resource.data);
      allow update: if isMine(resource.data)
        && unchanged('orgId') && unchanged('clientId')
        && (!touchesFields(['date', 'mode', 'entries', 'memo', 'lockSeq'])
            || (canEditProtected(resource.data.clientId, resource.data)
                && stampsCurrentSeq(resource.data.clientId, request.resource.data)));
    }

    // ── Notas explicativas (um documento por cliente e exercício) ────────
    match /explanatory_notes/{docId} {
      // Exercício sem notas gravadas (documento inexistente): o próprio escritório lê o vazio.
      // O cliente sai do id (`${clientId}_${AAAA}`).
      allow read: if hasProfile()
        && (resource == null
            ? docId.matches('^.+_[0-9]{4}$') && clientInMyOrg({'clientId': docId[0:docId.size() - 5]})
            : isMine(resource.data));
      allow delete: if isMine(resource.data);
      allow create: if isMine(request.resource.data)
        && clientInMyOrg(request.resource.data)
        && request.resource.data.year is string
        && request.resource.data.year.matches('^[0-9]{4}$')
        && docId == request.resource.data.clientId + '_' + request.resource.data.year
        && request.resource.data.notes is list
        && request.resource.data.notes.size() <= 30;
      allow update: if isMine(resource.data)
        && unchanged('orgId') && unchanged('clientId') && unchanged('year')
        && request.resource.data.notes is list
        && request.resource.data.notes.size() <= 30;
    }

    // ── Pendências com o cliente ─────────────────────────────────────────
    function requestOpen(req) {
      return req.status == 'OPEN' && request.time.toMillis() < req.expiresAtMs;
    }

    // Resposta do cliente: só texto, até 2000 caracteres (MAX_ANSWER_LENGTH em
    // src/lib/client-requests.ts), e a data em que foi escrita. Cada uso de `a` reavalia o
    // caminho até a resposta, e a avaliação tem um teto de 1000 expressões: por isso um uso
    // por campo — `lower()` e `matches()` só existem em texto, e qualquer outro tipo gera erro
    // de avaliação (a regra nega).
    function validAnswer(a) {
      return a.keys().hasOnly(['text', 'answeredAt'])
        && a.text.lower().size() <= 2000
        && a.get('answeredAt', '').matches('[0-9A-Za-z:.+-]{0,40}');
    }

    // As regras não têm laços: as respostas são conferidas uma a uma, até 24 — o que cabe, com
    // folga, no teto de 1000 expressões por avaliação (medido no emulador). Por isso um link
    // tem no máximo 24 perguntas (MAX_REQUEST_ITEMS em src/lib/client-requests.ts), e listas
    // maiores são recusadas.
    function validAnswers(l) {
      let n = l.size();
      return n <= 24
        && ((n < 1 || validAnswer(l[0])) && (n < 2 || validAnswer(l[1])) && (n < 3 || validAnswer(l[2])) && (n < 4 || validAnswer(l[3]))
            && (n < 5 || validAnswer(l[4])) && (n < 6 || validAnswer(l[5])) && (n < 7 || validAnswer(l[6])) && (n < 8 || validAnswer(l[7]))
            && (n < 9 || validAnswer(l[8])) && (n < 10 || validAnswer(l[9])) && (n < 11 || validAnswer(l[10])) && (n < 12 || validAnswer(l[11]))
            && (n < 13 || validAnswer(l[12])) && (n < 14 || validAnswer(l[13])) && (n < 15 || validAnswer(l[14])) && (n < 16 || validAnswer(l[15]))
            && (n < 17 || validAnswer(l[16])) && (n < 18 || validAnswer(l[17])) && (n < 19 || validAnswer(l[18])) && (n < 20 || validAnswer(l[19]))
            && (n < 21 || validAnswer(l[20])) && (n < 22 || validAnswer(l[21])) && (n < 23 || validAnswer(l[22])) && (n < 24 || validAnswer(l[23])));
    }

    match /client_requests/{token} {
      // O token é a credencial: leitura direta por id liberada; listagem só para o escritório.
      allow get: if true;
      allow list, delete: if isMine(resource.data);
      allow create: if isMine(request.resource.data)
        && clientInMyOrg(request.resource.data)
        && token.size() >= 32
        && request.resource.data.status == 'OPEN'
        && request.resource.data.expiresAtMs is int
        && request.resource.data.items is list
        && request.resource.data.items.size() >= 1
        && request.resource.data.items.size() <= 24;
      // Pelo link (sem login) só entram as respostas, uma por pergunta, e a data do envio.
      // Perguntas, valores e lançamentos (`items`) ficam como o escritório gravou.
      allow update: if (isMine(resource.data) && unchanged('orgId') && unchanged('clientId'))
        || (requestOpen(resource.data)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answers', 'respondedAt'])
            && request.resource.data.answers is list
            && request.resource.data.answers.size() == resource.data.items.size()
            && validAnswers(request.resource.data.answers)
            && request.resource.data.respondedAt is string
            && request.resource.data.respondedAt.size() <= 40);
    }

    // Legado: o cliente não envia mais arquivos. Nada novo é gravado; o escritório ainda
    // lê e apaga comprovantes antigos (ex.: ao excluir a empresa).
    match /client_request_files/{fileId} {
      allow get, list, delete: if isMine(resource.data);
      allow create, update: if false;
    }

    // ── Fechamento de competência ────────────────────────────────────────
    // Registro de auditoria de um fechamento ('close') ou da reabertura dele ('reopen'):
    // id derivado do próprio fechamento (periodAuditId em src/lib/periods.ts), pela chave
    // aleatória `auditKey`. Fechamentos antigos sem ela usavam o `lockedAt` em texto.
    function periodAuditIdOf(lockId, lock, kind) {
      return lockId + '_' + kind + '_' + lock.get('auditKey', lock.lockedAt);
    }
    function periodAudit(lockId, lock, kind) {
      return /databases/$(database)/documents/audit_log/$(periodAuditIdOf(lockId, lock, kind));
    }

    // O registro nasce nesta mesma gravação (não existia antes) e descreve este fechamento.
    // Como a trilha é somente-inclusão, cada fechamento e cada reabertura deixa o seu.
    function auditedNow(lockId, lock, kind, action) {
      return !exists(periodAudit(lockId, lock, kind))
        && existsAfter(periodAudit(lockId, lock, kind))
        && getAfter(periodAudit(lockId, lock, kind)).data.action == action
        && getAfter(periodAudit(lockId, lock, kind)).data.clientId == lock.clientId
        && getAfter(periodAudit(lockId, lock, kind)).data.month == lock.month;
    }

    function advancesLockStateOnClose(lockId, clientId) {
      let ls = lockStatePath(clientId);
      let after = getAfter(ls).data;
      return exists(ls)
        && after.count == get(ls).data.count + 1
        && after.seq == get(ls).data.seq + 1
        && after.get('lastEvent', {}).get('kind', '') == 'close'
        && after.get('lastEvent', {}).get('lockId', '') == lockId;
    }

    function validLockCloseUpdate(clientId) {
      let ev = request.resource.data.get('lastEvent', {});
      let id = ev.get('lockId', '_');
      let lockPath = /databases/$(database)/documents/period_locks/$(id);
      return id is string && id.size() > 0 && id != '_'
        && !exists(lockPath)
        && existsAfter(lockPath)
        && getAfter(lockPath).data.clientId == clientId
        && request.resource.data.count == resource.data.count + 1
        && request.resource.data.seq == resource.data.seq + 1;
    }

    function validLockReopenUpdate(clientId) {
      let ev = request.resource.data.get('lastEvent', {});
      let id = ev.get('lockId', '_');
      let lockPath = /databases/$(database)/documents/period_locks/$(id);
      return id is string && id.size() > 0 && id != '_'
        && exists(lockPath)
        && get(lockPath).data.clientId == clientId
        && !existsAfter(lockPath)
        && resource.data.count >= 1
        && request.resource.data.count == resource.data.count - 1
        && request.resource.data.seq == resource.data.seq;
    }

    function validYearCloseUpdate(clientId) {
      let ev = request.resource.data.get('lastEvent', {});
      let auditId = ev.get('lockId', '_');
      return auditId is string && auditId.size() > 0 && auditId != '_'
        && auditedNowAs(auditId, clientId, 'YEAR_CLOSE')
        && request.resource.data.count == resource.data.count
        && request.resource.data.seq == resource.data.seq + 1;
    }

    match /lock_state/{clientId} {
      allow read: if hasProfile() && (resource == null ? clientInMyOrg({'clientId': clientId}) : isMine(resource.data));
      // Nasce junto com a empresa (count = 0, seq = 0), nunca depois pelo cliente (empresas antigas via Admin SDK).
      allow create: if isMine(request.resource.data)
        && !exists(/databases/$(database)/documents/clients/$(clientId))
        && existsAfter(/databases/$(database)/documents/clients/$(clientId))
        && getAfter(/databases/$(database)/documents/clients/$(clientId)).data.orgId == myOrg()
        && request.resource.data.clientId == clientId
        && request.resource.data.count is int && request.resource.data.count == 0
        && request.resource.data.seq is int && request.resource.data.seq == 0;
      allow update: if isMine(resource.data)
        && unchanged('orgId') && unchanged('clientId')
        && request.resource.data.count is int
        && request.resource.data.seq is int
        && ((request.resource.data.get('lastEvent', {}).get('kind', '') == 'close' && validLockCloseUpdate(clientId))
            || (request.resource.data.get('lastEvent', {}).get('kind', '') == 'reopen' && validLockReopenUpdate(clientId))
            || (request.resource.data.get('lastEvent', {}).get('kind', '') == 'year' && validYearCloseUpdate(clientId)));
      allow delete: if isMine(resource.data) && isAdmin()
        && !exists(/databases/$(database)/documents/clients/$(clientId));
    }

    match /period_locks/{lockId} {
      allow read: if isMine(resource.data);
      allow create: if isMine(request.resource.data)
        && clientInMyOrg(request.resource.data)
        && request.resource.data.month.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')
        && lockId == request.resource.data.clientId + '_' + request.resource.data.month
        && request.resource.data.lockedByUid == request.auth.uid
        // Data do servidor (serverTimestamp), não do relógio do computador.
        && request.resource.data.lockedAt == request.time
        && request.resource.data.get('auditKey', 0) is string
        && request.resource.data.auditKey.matches('^[0-9A-Za-z:.+_-]{16,40}$')
        && auditedNow(lockId, request.resource.data, 'close', 'PERIOD_CLOSE')
        && advancesLockStateOnClose(lockId, request.resource.data.clientId);
      // Reabrir: só administrador, e com o registro de auditoria.
      allow delete: if isMine(resource.data) && isAdmin()
        && auditedNow(lockId, resource.data, 'reopen', 'PERIOD_REOPEN');
      allow update: if false;
    }

    // ── Saldos consolidados de competências fechadas ─────────────────────
    // Cache de leitura (src/lib/snapshots.ts): o app confere cada snapshot contra os
    // fechamentos, a configuração e a contagem de lançamentos antes de usar, e o regrava
    // quando não confere. Não é fonte de dados — só membros do escritório o gravam.
    // ── Notas fiscais: só o resumo do XML (o arquivo não é guardado) ─────
    // id `${clientId}_${chave}`. Sem `status`, a nota é autorizada (src/lib/nfe).
    function validInvoice(d) {
      return d.key is string && d.key.matches('^[0-9A-Z]{44}$')
        && d.issueDate is string && d.issueDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.direction in ['PURCHASE', 'SALE']
        && d.get('status', 'AUTHORIZED') in ['AUTHORIZED', 'CANCELLED']
        && d.total is number && d.total > 0
        && d.counterpartyDoc is string && d.counterpartyDoc.size() <= 20
        && d.counterpartyName is string && d.counterpartyName.size() <= 200
        && d.cfops is list && d.cfops.size() <= 60
        && d.installments is list && d.installments.size() <= 120
        && d.get('links', []) is list && d.get('links', []).size() <= 120;
    }

    match /invoice_summaries/{docId} {
      allow read, delete: if isMine(resource.data);
      allow create: if isMine(request.resource.data)
        && clientInMyOrg(request.resource.data)
        && docId == request.resource.data.clientId + '_' + request.resource.data.key
        && validInvoice(request.resource.data);
      allow update: if isMine(resource.data)
        && unchanged('orgId') && unchanged('clientId') && unchanged('key')
        && validInvoice(request.resource.data);
    }

    match /period_snapshots/{docId} {
      allow read, delete: if isMine(resource.data);
      allow create: if isMine(request.resource.data)
        && clientInMyOrg(request.resource.data)
        && docId == request.resource.data.clientId + '_' + request.resource.data.month;
      allow update: if isMine(resource.data)
        && unchanged('orgId') && unchanged('clientId') && unchanged('month');
    }

    // ── Trilha de auditoria (somente inclusão) ───────────────────────────
    // Ações aceitas: as de AuditAction (src/types/firestore.ts).
    function auditActions() {
      return ['CLASSIFY', 'RECLASSIFY', 'SPLIT', 'UNRECONCILE', 'APPROVE', 'AUTO_CLASSIFY',
        'PERIOD_CLOSE', 'PERIOD_REOPEN', 'TRANSFER', 'BATCH_DELETE', 'MEMO_REPAIR', 'OPENING_SAVE',
        'ACCOUNT_DELETE', 'QUERY_ASK', 'QUERY_RESOLVE', 'JOURNAL_CREATE', 'JOURNAL_UPDATE',
        'JOURNAL_DELETE', 'YEAR_CLOSE', 'YEAR_REOPEN'];
    }

    // Fechamento da competência citada no registro (`${clientId}_${month}`).
    function lockOfAudit(a) {
      return /databases/$(database)/documents/period_locks/$(a.clientId + '_' + a.get('month', ''));
    }
    // Registros de fechar/reabrir competência e encerrar/reabrir exercício só nascem junto
    // com a operação que descrevem — não dá para gravar "Fechou a competência" sozinho.
    function closesPeriodNow(id, a) {
      let p = lockOfAudit(a);
      return !exists(p) && existsAfter(p)
        && id == periodAuditIdOf(a.clientId + '_' + a.get('month', ''), getAfter(p).data, 'close');
    }
    function reopensPeriodNow(id, a) {
      let p = lockOfAudit(a);
      return exists(p) && !existsAfter(p)
        && id == periodAuditIdOf(a.clientId + '_' + a.get('month', ''), get(p).data, 'reopen');
    }
    // O encerramento avança o lock_state apontando este registro (validYearCloseUpdate).
    function closesYearNow(id, a) {
      let ls = lockStatePath(a.clientId);
      let after = getAfter(ls).data;
      return after.get('lastEvent', {}).get('kind', '') == 'year'
        && after.get('lastEvent', {}).get('lockId', '') == id
        && after.seq == get(ls).data.seq + 1;
    }
    // A reabertura (só administrador) tem o id `${closingAuditId}_reopen` de um encerramento
    // existente da mesma empresa; os lançamentos de encerramento saem na mesma gravação.
    function reopensYearNow(id, a) {
      let closeId = id.size() > 7 ? id[0:id.size() - 7] : '';
      return isAdmin()
        && id.matches('^.+_reopen$')
        && exists(auditDoc(closeId))
        && get(auditDoc(closeId)).data.action == 'YEAR_CLOSE'
        && get(auditDoc(closeId)).data.clientId == a.clientId;
    }
    function pairedAudit(id, a) {
      return !(a.action in ['PERIOD_CLOSE', 'PERIOD_REOPEN', 'YEAR_CLOSE', 'YEAR_REOPEN'])
        || (a.action == 'PERIOD_CLOSE' && closesPeriodNow(id, a))
        || (a.action == 'PERIOD_REOPEN' && reopensPeriodNow(id, a))
        || (a.action == 'YEAR_CLOSE' && closesYearNow(id, a))
        || (a.action == 'YEAR_REOPEN' && reopensYearNow(id, a));
    }

    match /audit_log/{entryId} {
      allow read: if isMine(resource.data);
      // Data do servidor (serverTimestamp), não do relógio do computador.
      allow create: if isMine(request.resource.data)
        && clientInMyOrg(request.resource.data)
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.at == request.time
        && request.resource.data.action in auditActions()
        && pairedAudit(entryId, request.resource.data);
      allow update, delete: if false;
    }

    // ── Escritório e responsável técnico ─────────────────────────────────
    match /orgs/{orgId} {
      allow read: if hasProfile() && orgId == myOrg();
      allow create, update: if hasProfile() && orgId == myOrg() && request.resource.data.orgId == orgId;
      allow delete: if false;
    }
  }
}
