NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
# Opcional: chave de site do reCAPTCHA Enterprise registrada no App Check (ver README > Segurança).
# Deixe vazio em desenvolvimento; sem ela o App Check não é iniciado.
NEXT_PUBLIC_FIREBASE_APPCHECK_SITE_KEY=

# Opcional (servidor): uids autorizados a consultar CNPJ, separados por vírgula. Vazio = qualquer usuário logado.
CNPJ_ALLOWED_UIDS=

# Opcional: monitoramento de erros (Sentry). Vazio = nada é enviado (desenvolvimento, modo local, E2E).
NEXT_PUBLIC_SENTRY_DSN=
# Só no build da Vercel, para enviar os source maps (rastros legíveis). Sem o token, o envio é pulado.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
