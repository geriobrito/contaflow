# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js & Build outputs
/.next/
/out/
/build
.vercel

# Testing & Coverage
/coverage

# Environment files & Secrets
.env
.env*.local
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# Firebase & Cloud Credentials
serviceAccountKey*.json
firebase-adminsdk*.json
google-services.json
*.pem
*.key
*.crt

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# System & IDE files
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.idea/
.vscode/

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Firebase emulator
firestore-debug.log
firebase-debug.log
ui-debug.log
